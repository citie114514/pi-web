{
  "name": "webpi",
  "version": "0.9.3",
  "description": "WebPi - out-of-the-box browser UI for the pi coding agent (downstream build of agegr/pi-web)",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "webpi": "bin/pi-web.js"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "webpi",
    "web-ui",
    "agent"
  ],
  "pi": {
    "extensions": [
      "./extensions/webpi/index.ts"
    ],
    "skills": [
      "./skills/webpi"
    ]
  },
  "files": [
    "bin",
    "desktop",
    "extensions",
    "skills",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "docs/webpi.md",
    "docs/upstream-inventory.md",
    "package.json"
  ],
  "scripts": {
    "postinstall": "node bin/prepare-terminal.js",
    "desktop": "electron desktop/main.js",
    "desktop:icons": "node desktop/make-icons.mjs",
    "desktop:dir": "electron-builder --dir",
    "desktop:dist": "electron-builder",
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "desktop:dist:win": "electron-builder --win",
    "desktop:dist:linux": "electron-builder --linux",
    "desktop:dist:mac": "electron-builder --mac",
    "desktop:portable": "node desktop/make-portable.mjs",
    "desktop:release": "electron-builder && node desktop/make-portable.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "js-yaml": "^5.2.3",
    "next": "16.3.6",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "7.8.5",
    "undici": "8.11.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "ansi_up": "^6.0.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "build": {
    "appId": "dev.webpi.desktop",
    "productName": "WebPi",
    "copyright": "MIT - WebPi (downstream build of pi-web by agegr)",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "desktop/**/*",
      "bin/**/*",
      "public/**/*",
      "next.config.ts",
      "package.json",
      ".next/**/*",
      "!.next/cache/**",
      "!.next/dev/**",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "desktop/assets/icon.png",
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebPi",
      "artifactName": "WebPi-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "WebPi-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "desktop/assets/icon.png",
      "category": "Development",
      "maintainer": "WebPi <webpi@users.noreply.github.com>",
      "synopsis": "WebPi - local browser UI for the pi coding agent",
      "description": "WebPi runs the pi coding agent's browser interface as a desktop application and starts and stops its local server with the app.",
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "WebPi",
          "Comment": "Local browser UI for the pi coding agent",
          "Categories": "Development;Utility;",
          "Terminal": "false"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "mac": {
      "icon": "desktop/assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0"
      },
      "darkModeSupport": true
    },
    "dmg": {
      "artifactName": "WebPi-Setup-${version}-${arch}.${ext}"
    }
  },
  "author": {
    "name": "WebPi",
    "email": "webpi@users.noreply.github.com"
  }
}
